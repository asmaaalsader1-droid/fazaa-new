rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // طلبات موقع العملاء — العميل غير مسجل الدخول ويحتاج الاستماع لوثيقته.
    match /pays/{docId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // تسجيلات الاستمارات العامة (اختياري، حسب حاجة موقع العملاء)
    match /registrations/{docId} {
      allow create, update: if true;
      allow read, delete: if request.auth != null;
    }

    // أوامر التوجيه الإضافية اختيارية؛ الإشارة الأساسية موجودة في pays.
    match /commands/{docId} {
      allow create: if true;
      allow read, update: if request.auth != null;
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
